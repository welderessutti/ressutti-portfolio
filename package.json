{
  "name": "ressutti-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run build:app && npm run copy:public && npm run build:functions",
    "build:app": "ng build --configuration production --localize",
    "copy:public": "node scripts/copy-public.js",
    "types:functions": "wrangler types functions/types.d.ts",
    "check:functions": "tsc --project functions/tsconfig.json --noEmit",
    "build:functions": "npm run types:functions && npm run check:functions && wrangler pages functions build --outdir=dist/cloudflare-functions",
    "preview:ssg": "node tools/preview-ssg.mjs",
    "watch": "ng build --watch --configuration development --localize=false",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.1",
  "dependencies": {
    "@angular/common": "^21.2.21",
    "@angular/compiler": "^21.2.21",
    "@angular/core": "^21.2.21",
    "@angular/forms": "^21.2.21",
    "@angular/platform-browser": "^21.2.21",
    "@angular/platform-server": "^21.2.21",
    "@angular/router": "^21.2.21",
    "@angular/ssr": "^21.2.21",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.21",
    "@angular/localize": "^21.2.21",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.125.0"
  }
}
